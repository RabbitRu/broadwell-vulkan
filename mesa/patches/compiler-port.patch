+      if (tail) { cmd->wddm->tail = tail; write_tail(tail, ANV_NULL_ADDRESS, false); }
+   }
+   struct anv_wddm_cmd_state *s = cmd->wddm;
+   s->chunks[s->chunk_count - 1].length = (uint32_t)((char *)cmd->batch.next - (char *)cmd->batch.start);
+}
