+         .dstOffset = offset, .extent = copied,
+      };
+      const VkCopyImageInfo2 copy = {
+         .sType = VK_STRUCTURE_TYPE_COPY_IMAGE_INFO_2, .srcImage = src, .srcImageLayout = VK_IMAGE_LAYOUT_GENERAL,
