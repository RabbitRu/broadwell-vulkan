+      D3DKMT_OPENADAPTERFROMLUID open{};
+      open.AdapterLuid = luid;
+      check(D3DKMTOpenAdapterFromLuid(&open), "OpenAdapterFromLuid");
+      adapter_ = open.hAdapter;
