+/* Hardware resource bring-up using the real Mesa Gen8 BLORP executor.
+ * No Vulkan entrypoints are implemented by this test executable. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <wchar.h>
+#include <direct.h>
+#include "compiler/glsl_types.h"
