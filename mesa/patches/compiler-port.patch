+      *out = static_cast<char *>(pool->cpu) + offset;
+   });
+}
+extern "C" int hasvk_wddm_readonly_pool_destroy(hasvk_wddm_readonly_pool *pool)
+{
+   if (!pool) return 0;
+   return checked([&] {
+      std::lock_guard<std::mutex> lock(pool->device->mutex);
+      pool->device->pools.erase(pool);
+      delete pool;
+   });
+}
