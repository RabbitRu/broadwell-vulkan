+      {28, 0x4000a}, {48, 1}, {52, 1}, {60, 1}, {64, 0x21},
+      {80, 1}, {940, 0x14330000},
+   };
+   for (const auto &field : fields) memcpy(metadata.data() + field[0], &field[1], 4);
+   memcpy(metadata.data() + 40, &bytes, 8);
+   return metadata;
