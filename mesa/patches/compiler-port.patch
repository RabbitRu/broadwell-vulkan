+VKAPI_ATTR void VKAPI_CALL anv_GetPhysicalDeviceMemoryProperties(VkPhysicalDevice handle, VkPhysicalDeviceMemoryProperties *properties)
+{
+   ANV_FROM_HANDLE(anv_physical_device, physical, handle);
