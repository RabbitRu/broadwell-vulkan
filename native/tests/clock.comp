#version 450
#extension GL_ARB_shader_clock : require
// One subgroup runs a long dependent FMA loop and stores how many shader
// clock (EU tm0) ticks it took; flops_probe compares that with the GPU
// timestamp duration of the dispatch to get the tick rate.
layout(local_size_x = 8) in;
layout(std430, binding = 0) buffer Data { uvec2 ticks; float sink[]; };
void main()
{
   float a = float(gl_GlobalInvocationID.x) * 1e-7;
   const float m = 0.9999, k = 0.0001;
   uvec2 t0 = clock2x32ARB();
   for (uint i = 0u; i < 262144u; ++i)
      a = fma(a, m, k);
   uvec2 t1 = clock2x32ARB();
   uint lo = t1.x - t0.x, hi = t1.y - t0.y - (t1.x < t0.x ? 1u : 0u);
   if (gl_GlobalInvocationID.x == 0u)
      ticks = uvec2(lo, hi);
   sink[gl_GlobalInvocationID.x] = a;
}
