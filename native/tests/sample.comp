#version 450
// Sampler throughput: each invocation takes 16 bilinear samples of a
// 1024x1024 RGBA8 texture around its own texel (neighbouring invocations
// read neighbouring texels, like a full-screen pass).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D tex;
layout(std430, binding = 1) buffer Data { vec4 v[]; };
void main()
{
   vec2 uv = (vec2(gl_GlobalInvocationID.xy) + 0.5) / 1024.0;
   vec4 sum = vec4(0);
   for (int i = 0; i < 16; ++i)
      sum += textureLod(tex, uv + vec2(i & 3, i >> 2) * (0.37 / 1024.0), 0.0);
   v[(gl_GlobalInvocationID.y * 1024u + gl_GlobalInvocationID.x) & 1023u] = sum;
}
