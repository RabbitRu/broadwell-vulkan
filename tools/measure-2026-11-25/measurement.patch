+void
+anv_wddm_profile_install(struct vk_device_dispatch_table *d)
+{
+   if (!enabled()) {
+      if (clamp_width() && d->CmdBeginRendering) {
+         g.orig = *d;
+         d->CmdBeginRendering = wrap_clamp_CmdBeginRendering;
+         fprintf(stderr, "HasVK/WDDM EXPERIMENT: render areas at least %u wide shrunk to 16x16\n", clamp_width());
+      }
+      return;
+   }
+   static int installed;
+   if (installed++) { fprintf(stderr, "HasVK/WDDM profile: only the first device is profiled\n"); return; }
+   mtx_init(&g.mutex, mtx_plain);
+   g.orig = *d;
+#define WRAP(name) if (d->name) d->name = wrap_##name
+   WRAP(QueuePresentKHR);
+   WRAP(CmdBeginRenderPass); WRAP(CmdBeginRenderPass2); WRAP(CmdEndRenderPass); WRAP(CmdEndRenderPass2);
+   WRAP(CmdBeginRendering); WRAP(CmdEndRendering);
+   WRAP(CmdDraw); WRAP(CmdDrawIndexed); WRAP(CmdDrawIndirect); WRAP(CmdDrawIndexedIndirect);
+   WRAP(BeginCommandBuffer); WRAP(CmdExecuteCommands); WRAP(CmdBindPipeline); WRAP(EndCommandBuffer);
+   WRAP(CmdDispatch); WRAP(CmdDispatchIndirect); WRAP(CmdCopyBuffer); WRAP(CmdCopyImage);
+   WRAP(CmdCopyBufferToImage); WRAP(CmdCopyImageToBuffer); WRAP(CmdBlitImage); WRAP(CmdResolveImage);
+   WRAP(CmdClearColorImage); WRAP(CmdClearDepthStencilImage); WRAP(CmdFillBuffer); WRAP(CmdUpdateBuffer);
+   if (getenv("HASVK_WDDM_PROFILE_BARRIERS")) { WRAP(CmdPipelineBarrier); WRAP(CmdPipelineBarrier2); }
+   if (getenv("HASVK_EXP_FRAMELOG")) {
+      if (d->CmdPipelineBarrier && !getenv("HASVK_WDDM_PROFILE_BARRIERS")) d->CmdPipelineBarrier = wrap_log_CmdPipelineBarrier;
+      WRAP(CmdPipelineBarrier2); WRAP(CmdClearAttachments); WRAP(QueueSubmit); WRAP(QueueSubmit2);
+   }
+#undef WRAP
+   fprintf(stderr, "HasVK/WDDM profile: timing render passes, dispatches and transfers%s\n", draws_enabled() ? " and every draw" : "");
+}
+
+static int compare_buckets(const void *a, const void *b)
+{
+   const struct bucket *x = a, *y = b;
+   return x->ticks < y->ticks ? 1 : x->ticks > y->ticks ? -1 : 0;
+}
+
+static void add(const struct meta *m, uint64_t ticks, const uint64_t *stats)
+{
+   uint32_t i = 0;
+   for (; i < g.bucket_count; ++i) {
+      const struct meta *k = &g.buckets[i].key;
+      if (k->kind == m->kind && k->object == m->object && k->width == m->width && k->height == m->height &&
+          k->pass_object == m->pass_object && k->pass_width == m->pass_width && k->pass_height == m->pass_height &&
+          k->depth_flags == m->depth_flags) break;
+   }
+   if (i == g.bucket_count) {
+      if (i == BUCKETS) return;
+      g.buckets[g.bucket_count++] = (struct bucket){.key = *m};
+      g.buckets[i].key.draws = 0;
+      describe(m, g.buckets[i].text, sizeof(g.buckets[i].text));
+   }
+   ++g.buckets[i].count; g.buckets[i].ticks += ticks; g.buckets[i].draws += m->draws;
+   if (stats) for (int s = 0; s < 6; ++s) g.buckets[i].stats[s] += stats[s];
+}
+
+static const char *pipeline_text(uint64_t object)
+{
+   for (uint32_t i = 0; i < g.pipeline_count; ++i)
+      if (g.pipelines[i].pipeline == (const void *)(uintptr_t)object) return g.pipelines[i].text;
+   return "?";
+}
+
+static int describe_pass(uint64_t object, uint32_t aux, char *out, size_t size)
+{
+   if (!object) return snprintf(out, size, " no pass");
+   if (object >> 63) {   /* dynamic rendering: see attachment_bits */
+      static const char *const loads[] = {"", "/clr", "/load", "/?"};
+      int n = snprintf(out, size, " dyn, col:");
+      for (uint32_t i = 0; i < 5; ++i) {
+         const uint32_t bits = (object >> (12 * i)) & 0xfff;
+         if (i == 4 && n < (int)size) n += snprintf(out + n, size - n, " depth:");
+         if (!bits || n >= (int)size - 24) continue;
+         n += snprintf(out + n, size - n, " %u%s%s%s", bits & 0x1ff, i < 4 ? ((aux >> (4 * i)) & 15 ? "/aux" : "") : ((aux >> 16) & 15 ? "/aux" : ""),
+                       loads[(bits >> 9) & 3], bits >> 11 ? "/nostore" : "");
+      }
+      return n;
+   }
+   VK_FROM_HANDLE(vk_render_pass, pass, (VkRenderPass)(uintptr_t)object);
+   int n = snprintf(out, size, " %u subpass, att:", pass->subpass_count);
+   for (uint32_t i = 0; i < pass->attachment_count && n < (int)size - 24; ++i)
+      n += snprintf(out + n, size - n, " %d%s%s%s%s", pass->attachments[i].format, i < 8 && (aux >> (4 * i)) & 15 ? "/aux" : "",
+                    pass->attachments[i].samples > 1 ? "xMS" : "",
+                    pass->attachments[i].load_op == VK_ATTACHMENT_LOAD_OP_CLEAR ? "/clr" :
+                    pass->attachments[i].load_op == VK_ATTACHMENT_LOAD_OP_LOAD ? "/load" : "",
+                    pass->attachments[i].store_op == VK_ATTACHMENT_STORE_OP_DONT_CARE ? "/nostore" : "");
+   return n;
+}
+
+static void describe(const struct meta *m, char *out, size_t size)
+{
+   if (m->kind == KIND_DRAW) {
+      int n = snprintf(out, size, "draw in %4ux%-4u", m->pass_width, m->pass_height);
+      n += describe_pass(m->pass_object, 0, out + n, size - n);
+      if (n < (int)size) snprintf(out + n, size - n, " :: %s", pipeline_text(m->object));
+      return;
+   }
+   int n = snprintf(out, size, "%-11s %4ux%-4u", kind_names[m->kind], m->width, m->height);
+   if (m->kind == KIND_DISPATCH && n < (int)size) { snprintf(out + n, size - n, " :: %s", pipeline_text(m->object)); return; }
+   if (m->kind == KIND_RESOLVE && m->object >> 32 && n < (int)size) {   /* a timed barrier2 */
+      snprintf(out + n, size - n, " barrier fmt %u layout %u -> %u", (unsigned)(m->object >> 32), (unsigned)((m->object >> 16) & 0xffff),
+               (unsigned)(m->object & 0xffff));
+      return;
+   }
+   if (m->kind != KIND_PASS || !m->object) return;
+   n += describe_pass(m->object, m->aux, out + n, size - n);
+   if (m->depth_flags && n < (int)size)
+      snprintf(out + n, size - n, " | depth clear %.3f %s%s", m->depth_clear, m->depth_flags & 2 ? "sampled " : "",
+               m->depth_flags & 4 ? "fast" : "SLOW");
+}
+
+void
+anv_wddm_profile_report(struct anv_device *device)
+{
+   if (!enabled() || !g.pool || g.device != device) return;
+   if (mtx_trylock(&g.mutex) != thrd_success) return;
+   const VkDevice handle = device_handle(device);
+   const uint64_t mask = device->physical->info.timestamp_frequency ? (1ull << 36) - 1 : ~0ull;
+   for (uint32_t slot = 0; slot < PAIRS; ++slot) {
+      if (p_atomic_read(&g.state[slot]) != 1) continue;
+      uint64_t r[4];
+      if (g.orig.GetQueryPoolResults(handle, g.pool, slot * 2, 2, sizeof(r), r, 16,
+                                     VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT) != VK_SUCCESS ||
+          !r[1] || !r[3])
+         continue;
+      uint64_t stats[7];
+      const bool pass = g.meta[slot].kind == KIND_PASS;
+      if (pass && (g.orig.GetQueryPoolResults(handle, g.stats_pool, slot, 1, sizeof(stats), stats, sizeof(stats),
+                                              VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT) != VK_SUCCESS ||
+                   !stats[6]))
+         continue;
+      add(&g.meta[slot], (r[2] - r[0]) & mask, pass ? stats : NULL);
+      g.orig.ResetQueryPool(handle, g.pool, slot * 2, 2);
+      if (pass) g.orig.ResetQueryPool(handle, g.stats_pool, slot, 1);
+      p_atomic_set(&g.state[slot], 0);
+   }
+   const uint64_t now = os_time_get_nano() / 1000000;
+   if (!g.window_start_ms) g.window_start_ms = now;
+   if (now - g.window_start_ms >= 5000) {
+      const uint64_t frames = p_atomic_xchg(&g.frames, 0);
+      const double ms_per_tick = 1000.0 / device->physical->info.timestamp_frequency;
+      const double divisor = frames ? (double)frames : 1.0;
+      qsort(g.buckets, g.bucket_count, sizeof(g.buckets[0]), compare_buckets);
+      double by_kind[KIND_CMDBUF + 1] = {0};
+      for (uint32_t i = 0; i < g.bucket_count; ++i) by_kind[g.buckets[i].key.kind] += g.buckets[i].ticks * ms_per_tick / divisor;
+      fprintf(stderr, "HasVK/WDDM profile: %llu frames in %.1f s, GPU ms/frame: passes %.2f, dispatches %.2f, copies %.2f, blits %.2f, "
+              "clears %.2f, resolves/barriers %.2f, fills %.2f, draws %.2f; primary command buffers %.2f (%llu skipped)\n",
+              (unsigned long long)frames, (now - g.window_start_ms) / 1000.0, by_kind[KIND_PASS], by_kind[KIND_DISPATCH],
+              by_kind[KIND_COPY], by_kind[KIND_BLIT], by_kind[KIND_CLEAR], by_kind[KIND_RESOLVE], by_kind[KIND_FILL],
+              by_kind[KIND_DRAW], by_kind[KIND_CMDBUF], (unsigned long long)g.skipped);
+      for (uint32_t i = 0, shown = 0; i < g.bucket_count && shown < 40; ++i) {
+         const struct bucket *b = &g.buckets[i];
+         if (b->key.kind == KIND_CMDBUF) continue;
+         ++shown;
+         fprintf(stderr, "  %6.2f ms/frame %6.1f/frame avg %7.3f ms draws %6.1f | %s\n", b->ticks * ms_per_tick / divisor,
+                 b->count / divisor, b->ticks * ms_per_tick / b->count, (double)b->draws / b->count, b->text);
+         if (b->key.kind == KIND_PASS && shown <= 16)
+            fprintf(stderr, "      per pass: %.1fk IA vertices, %.1fk prims, %.1fk VS, %.1fk clip in, %.1fk clip out, %.1fk FS\n",
+                    b->stats[0] / 1e3 / b->count, b->stats[1] / 1e3 / b->count, b->stats[2] / 1e3 / b->count,
+                    b->stats[3] / 1e3 / b->count, b->stats[4] / 1e3 / b->count, b->stats[5] / 1e3 / b->count);
+      }
+      g.bucket_count = 0; g.skipped = 0; g.window_start_ms = now;
+   }
+   mtx_unlock(&g.mutex);
+}
+#endif
